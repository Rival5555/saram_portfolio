# ==============================================================================
# Environment Variable Template — Saram Zafar Portfolio
# ==============================================================================
# SECURITY NOTICE:
# 1. Never commit real .env, .env.local, or .env.production files to Git.
# 2. Any variable prefixed with VITE_ is bundled into client-side JavaScript
#    and is publicly visible in the browser. NEVER store private API keys,
#    database credentials, or secret tokens in VITE_* variables.
# ==============================================================================

# Optional public site URL used for canonical metadata (if configured in the future)
# VITE_PUBLIC_SITE_URL=https://your-domain.example.com
